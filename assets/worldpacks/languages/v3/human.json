{
  "version": 1,
  "id": "human",
  "templates": {
    "report_shortage": "{actor_name}: {place_name} has {stock} {food}; we need {target}.",
    "report_stock": "{actor_name}: {place_name} has {stock} {food}; the need is {target}.",
    "request_food": "{actor_name} asks {recipient_name} for {quantity} {food} at {total_cost} total.",
    "offer_food": "{actor_name} offers {recipient_name} {quantity} {food} for {total_cost} total.",
    "counter_offer": "{actor_name} offers {quantity} {food} for {total_cost} total instead.",
    "accept": "{actor_name} accepts {total_cost} total for {quantity} {food}.",
    "decline": "{actor_name} declines the offer for {quantity} {food}.",
    "condition": "{actor_name}: {quantity} {food} can move from {place_name} at {condition}.",
    "recall_success": "{actor_name} recalls event {event_id}: {quantity} {food} for {total_cost} total succeeded.",
    "recall_failure": "{actor_name} recalls event {event_id}: {quantity} {food} for {total_cost} total failed.",
    "thank": "{actor_name} thanks {recipient_name} for the food.",
    "end": "{actor_name} ends the exchange with {recipient_name}."
  },
  "lexicon": {
    "food": {"singular": "food", "plural": "food"},
    "ash": "ash", "ashes": "ashes", "daylight": "daylight", "vault": "vault"
  }
}
